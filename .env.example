# SMTP for /api/contact (Google Workspace). Enquiries go to dhiya@dhiya.ai; the visitor gets a branded acknowledgement.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# The Workspace account that sends, and a 16-character app password for it (not the normal password).
SMTP_USER=dhiya@dhiya.ai
SMTP_PASS=gngs ibsc huzt keam
# Optional. Defaults to "Dhiya Labs <SMTP_USER>". Must be SMTP_USER or a "Send mail as" alias of it, or Gmail rewrites it.
MAIL_FROM=Dhiya Labs <dhiya@dhiya.ai>
