---
/** Launch curtain for the homepage. A field of plum, lilac and blue bands with one card: the Mandala, folded.
    Clicking it (or Enter) unfolds the eight rays in turn, lifts the curtain and shows the welcome. Logic in /js/launch-ceremony.js. */
const previewAllowed = import.meta.env.DEV;

// A fixed arrangement keeps the light field consistent across renders.
const palette = ['#250B1E', '#342136', '#49324F', '#62476F', '#80628E', '#B89CC8', '#555E9C', '#3C426E', '#2F1C35'];
let seed = 406;
const next = () => {
  seed = (seed * 16807) % 2147483647;
  return seed / 2147483647;
};
const bands = Array.from({ length: 184 }, (_, index) => ({
  width: .3 + next() * 1.8,
  color: palette[Math.floor(next() * palette.length)],
  delay: (2820 + next() * 320).toFixed(0),
  origin: index % 3 === 0 ? 'bottom' : 'top',
}));
const eight = Array.from({ length: 8 }, (_, i) => i);
---
<dialog class="launch-ceremony" data-launch-ceremony data-preview-allowed={previewAllowed ? 'true' : 'false'} aria-labelledby="launch-title" aria-describedby="launch-description">
  <div class="launch-field" aria-hidden="true">
    {bands.map((band) => <span class="launch-band" style={`--band-width:${band.width};--band-color:${band.color};--band-delay:${band.delay}ms;--band-origin:${band.origin}`}></span>)}
    <div class="launch-field-light"></div>
  </div>

  <div class="launch-card">
    <div class="launch-card-heading">
      <span class="launch-wordmark" aria-label="Dhiya">Dhıya<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 0 2.4 9.6L24 12l-9.6 2.4L12 24l-2.4-9.6L0 12l9.6-2.4Z" /></svg></span>
    </div>

    <button class="launch-open" type="button" data-launch-go autofocus aria-label="Open Dhiya">
      <span class="launch-thread" aria-hidden="true"></span>
      <svg class="launch-mark" viewBox="0 0 400 400" aria-hidden="true" focusable="false">
        <defs><radialGradient id="launch-lamp"><stop offset="0" stop-color="#E9B44C" stop-opacity=".95" /><stop offset=".35" stop-color="#EFC86E" stop-opacity=".5" /><stop offset=".72" stop-color="#EFC86E" stop-opacity=".16" /><stop offset="1" stop-color="#EFC86E" stop-opacity="0" /></radialGradient></defs>
        <g transform="translate(200 200)">
          {eight.map((i) => <g transform={`rotate(${i * 45})`}><g class="launch-ray" style={`--i:${i}`}><path d="M0,-188 L-26,-124 L0,-96 Z" fill="#A1ACE2" /><path d="M0,-188 L26,-124 L0,-96 Z" fill="#5662A6" /></g></g>)}
          {eight.map((i) => <g transform={`rotate(${22.5 + i * 45})`}><g class="launch-petal" style={`--i:${i}`}><path d="M0,-118 L-30,-72 L0,-44 Z" fill="#EAE0F0" /><path d="M0,-118 L30,-72 L0,-44 Z" fill="#B89CC8" /></g></g>)}
          <path d="M0,-90.5 L90.5,0 L0,0 Z" fill="#B89CC8" /><path d="M90.5,0 L0,90.5 L0,0 Z" fill="#654B75" /><path d="M0,90.5 L-90.5,0 L0,0 Z" fill="#654B75" /><path d="M-90.5,0 L0,-90.5 L0,0 Z" fill="#B89CC8" />
          <path d="M-20,-48 L20,-48 L48,-20 L48,20 L20,48 L-20,48 L-48,20 L-48,-20 Z" fill="#221A21" />
          <circle class="launch-glow" r="33" fill="url(#launch-lamp)" />
          <circle class="launch-flame" r="9.5" fill="#E9B44C" />
        </g>
      </svg>
    </button>

    <div class="launch-card-caption">
      <h1 id="launch-title">Data centre operations that work as one.</h1>
      <p id="launch-description">Click the mark or press Enter.</p>
    </div>
  </div>

  <div class="launch-welcome" aria-hidden="true">
    <svg class="launch-welcome-star" viewBox="0 0 24 24"><path d="m12 0 2.4 9.6L24 12l-9.6 2.4L12 24l-2.4-9.6L0 12l9.6-2.4Z" /></svg>
    <p class="launch-welcome-title">Welcome to Dhiya</p>
    <p class="launch-welcome-note">People, systems, shared light.</p>
  </div>

  <div class="launch-bottom">
    <span class="launch-enter" aria-hidden="true">Enter <span>↵</span></span>
    <button type="button" class="launch-skip" data-launch-skip>Skip intro <span aria-hidden="true">↗</span></button>
  </div>
  <span class="launch-sr" role="status" aria-live="polite" data-launch-status></span>
</dialog>
<script is:inline src="/js/launch-ceremony.js"></script>

<style>
  .launch-ceremony{position:fixed;inset:0;display:grid;place-items:center;width:100%;height:100%;height:100dvh;max-width:none;max-height:none;margin:0;padding:24px;border:0;border-radius:0;background:transparent;color:#f3f0e4;overflow:hidden;font-family:var(--font);isolation:isolate;overscroll-behavior:contain}
  .launch-ceremony:not([open]){display:none}
  .launch-ceremony::backdrop{background:transparent}
  .launch-field{position:absolute;inset:0;z-index:-1;display:flex;overflow:hidden;pointer-events:none;background:#250B1E}
  .launch-band{height:100%;flex:var(--band-width) 1 0;min-width:0;background:var(--band-color);transform-origin:center var(--band-origin);box-shadow:inset -1px 0 #250B1E30}
  .launch-field::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,#250B1E38,transparent 32%,#250B1E38);pointer-events:none}
  .launch-field-light{position:absolute;inset:0 auto 0 -60%;width:55%;background:linear-gradient(90deg,transparent,#B89CC81C,transparent);animation:launch-light-pass 18s linear infinite;pointer-events:none}
  .launch-card{position:relative;width:clamp(340px,30vw,510px);aspect-ratio:1.22;background:#250B1E;border:1px solid #B89CC84D;border-radius:6px;box-shadow:0 18px 65px #180B2140;display:flex;flex-direction:column;justify-content:space-between;text-align:center}
  .launch-card-heading{padding:clamp(22px,2.6vw,36px) 24px 0;display:flex;flex-direction:column;align-items:center}
  .launch-wordmark{position:relative;display:inline-block;font:500 28px/1 var(--font);letter-spacing:-1.4px;color:#F7F0ED}
  .launch-wordmark svg{position:absolute;width:8px;height:8px;left:35px;top:-3px;fill:#B89CC8}
  .launch-open{position:relative;flex:1;min-height:0;width:100%;border:0;border-radius:0;background:none;color:inherit;cursor:pointer;display:grid;place-items:center;padding:0;isolation:isolate}
  .launch-thread{position:absolute;z-index:-1;top:50%;left:0;right:0;height:1px;background:#B89CC82E}
  .launch-mark{display:block;width:clamp(124px,11.5vw,172px);height:auto;overflow:visible;transition:transform .5s cubic-bezier(.2,.8,.2,1)}
  .launch-ray{transform:scale(.6);opacity:.3;transition:transform .45s cubic-bezier(.2,.8,.2,1),opacity .45s}
  .launch-petal{opacity:.62;transition:opacity .45s}
  .launch-glow{opacity:.45;animation:launch-breathe 3.4s ease-in-out infinite}
  .launch-flame{opacity:.8}
  .launch-open:hover .launch-ray,.launch-open:focus-visible .launch-ray{transform:scale(.74);opacity:.6}
  .launch-open:hover .launch-petal,.launch-open:focus-visible .launch-petal{opacity:.85}
  .launch-open:hover .launch-mark,.launch-open:focus-visible .launch-mark{transform:scale(1.04)}
  .launch-open:focus-visible{outline:none}
  .launch-open:focus-visible .launch-mark{outline:1px solid #B89CC8;outline-offset:12px;border-radius:50%}
  .launch-card-caption{padding:0 16px clamp(22px,2.4vw,34px)}
  .launch-card-caption h1{font:400 clamp(14px,1.15vw,17px)/1.4 var(--font);letter-spacing:-.01em;margin:0;color:#F0E7F2}
  .launch-card-caption p{font:400 11px/1.5 var(--font);letter-spacing:.01em;margin:8px 0 0;max-width:none;color:#B89CC8}
  .launch-welcome{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:22px;padding:24px;text-align:center;pointer-events:none;opacity:0;background:radial-gradient(ellipse at center,#250B1EF2 0%,#250B1ED9 27%,#250B1E8C 58%,#250B1E26 100%)}
  .launch-welcome-star{width:32px;height:32px;fill:#B89CC8;filter:drop-shadow(0 0 14px #B89CC866)}
  .launch-welcome-title{margin:0;max-width:none;font:500 clamp(32px,5.8vw,84px)/1.12 var(--font);letter-spacing:-.045em;color:#EAE0F0;background:linear-gradient(110deg,#B89CC8 4%,#F7F0ED 39%,#EAE0F0 64%,#C8B1D6 100%);background-clip:text;-webkit-background-clip:text;-webkit-text-fill-color:transparent;text-shadow:0 0 48px #B89CC814}
  .launch-welcome-note{margin:0;max-width:none;font:400 clamp(12px,1.1vw,16px)/1.5 var(--font);letter-spacing:.06em;color:#D9C8E4}
  .launch-bottom{position:absolute;left:clamp(24px,4vw,64px);right:clamp(24px,4vw,64px);bottom:max(26px,env(safe-area-inset-bottom));display:flex;align-items:center;justify-content:flex-end;gap:16px}
  .launch-enter{position:absolute;left:50%;transform:translateX(-50%);display:flex;align-items:center;gap:12px;color:#E0CEE8;font:400 10px/1.4 var(--mono);text-transform:uppercase;letter-spacing:.25em}
  .launch-enter>span{font-size:16px;letter-spacing:0;opacity:.7}
  .launch-skip{display:flex;align-items:center;gap:12px;font:400 11px/1.5 var(--font);color:#F0E7F2;padding:10px 0;background:none;border:0;border-bottom:1px solid #B89CC866;border-radius:0;cursor:pointer}
  .launch-skip:hover{color:#fff;border-color:#fff}
  .launch-skip:focus-visible{outline:2px solid #B89CC8;outline-offset:5px}
  .launch-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
  .launch-ceremony[data-state="opening"]{pointer-events:none}
  .launch-ceremony[data-state="opening"] .launch-ray{animation:launch-ray-out .5s cubic-bezier(.2,.8,.2,1) calc(var(--i) * 70ms) forwards}
  .launch-ceremony[data-state="opening"] .launch-petal{opacity:1}
  .launch-ceremony[data-state="opening"] .launch-glow{animation:launch-glow-up .9s ease forwards}
  .launch-ceremony[data-state="opening"] .launch-flame{opacity:1}
  .launch-ceremony[data-state="opening"] .launch-mark{outline:none;animation:launch-mark-out .7s cubic-bezier(.3,0,.2,1) 1s forwards}
  .launch-ceremony[data-state="opening"] .launch-thread{animation:launch-thread-out .5s ease forwards}
  .launch-ceremony[data-state="opening"] .launch-card-heading,.launch-ceremony[data-state="opening"] .launch-card-caption,.launch-ceremony[data-state="opening"] .launch-bottom{animation:launch-quiet-out .3s ease forwards}
  .launch-ceremony[data-state="opening"] .launch-card{animation:launch-card-out .7s cubic-bezier(.2,.7,.2,1) 1s forwards}
  .launch-ceremony[data-state="opening"] .launch-welcome{animation:launch-welcome-in 2.7s ease 1s both}
  .launch-ceremony[data-state="opening"] .launch-band{animation:launch-band-out .65s cubic-bezier(.4,0,.2,1) var(--band-delay) forwards}
  .launch-ceremony[data-state="opening"] .launch-field{background:transparent}
  .launch-ceremony[data-state="opening"] .launch-field::after,.launch-ceremony[data-state="opening"] .launch-field-light{animation:launch-quiet-out .4s ease forwards}
  @keyframes launch-light-pass{to{transform:translateX(300%)}}
  @keyframes launch-breathe{50%{opacity:.85}}
  @keyframes launch-ray-out{to{transform:scale(1);opacity:1}}
  @keyframes launch-glow-up{to{opacity:1;transform:scale(1.35)}}
  @keyframes launch-mark-out{to{opacity:0;transform:scale(1.5)}}
  @keyframes launch-thread-out{to{opacity:0;transform:scaleX(.4)}}
  @keyframes launch-quiet-out{to{opacity:0}}
  @keyframes launch-card-out{to{opacity:0;transform:scale(.985) translateY(5px)}}
  @keyframes launch-welcome-in{0%{opacity:0;transform:translateY(8px)}18%,76%{opacity:1;transform:translateY(0)}100%{opacity:0;transform:translateY(-5px)}}
  @keyframes launch-band-out{to{opacity:0;transform:scaleY(.96)}}
  @media(max-width:600px){.launch-card{width:min(100%,360px);min-height:290px;aspect-ratio:1.15}.launch-card-heading{padding-top:28px}.launch-card-caption{padding-bottom:28px}.launch-enter{bottom:62px}.launch-bottom{bottom:max(18px,env(safe-area-inset-bottom))}.launch-field-light{animation:none}}
  @media(max-height:480px){.launch-card{width:min(100%,340px);height:260px;min-height:0;aspect-ratio:auto}.launch-card-heading{padding-top:18px}.launch-card-caption{padding-bottom:16px}.launch-mark{width:84px}.launch-bottom{bottom:10px}.launch-enter{display:none}}
  @media(prefers-reduced-motion:reduce){.launch-ceremony *{animation:none!important;transition:none!important}.launch-ceremony[data-state="opening"] .launch-card,.launch-ceremony[data-state="opening"] .launch-bottom{visibility:hidden}.launch-ceremony[data-state="opening"] .launch-welcome{opacity:1}}
</style>
