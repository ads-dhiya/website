<style>
  .ann.dc-bar{position:relative;z-index:3;display:block;margin:0;padding:0;background:#221A21;color:#F7F0ED;border-bottom:1px solid #3E2F39;font-family:var(--font);overflow:hidden}
  .dc-inner{display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);align-items:center;gap:20px;max-width:1200px;min-height:52px;margin-inline:auto;padding-inline:max(20px,4vw)}
  .dc-scene{display:flex;align-items:center;height:52px}
  .dc-scene :global(svg){display:block;height:48px;width:auto}
  .dc-hall{justify-content:flex-start}.dc-plant{justify-content:flex-end}
  .dc-scene :global(.led){animation:dc-blink 2.4s ease-in-out infinite;animation-delay:var(--d)}
  @keyframes dc-blink{0%,100%{opacity:1}50%{opacity:.25}}
  .dc-link{display:inline-flex;align-items:center;gap:10px;min-height:36px;color:#F7F0ED;text-decoration:none;font-size:13px;font-weight:500;letter-spacing:.01em;white-space:nowrap}
  .dc-dot{width:7px;height:7px;border-radius:50%;background:#B89CC8;box-shadow:0 0 0 3px #B89CC833}
  .dc-arrow{color:#B89CC8;font-size:15px;transition:transform .2s,color .2s}
  .dc-link:hover .dc-arrow{color:#F7F0ED;transform:translate(2px,-2px)}
  .dc-link:focus-visible{outline:2px solid #B89CC8;outline-offset:3px;border-radius:4px}
  @media(max-width:860px){.dc-plant{display:none}.dc-inner{grid-template-columns:auto 1fr;gap:14px}.dc-link{justify-self:end}}
  @media(max-width:560px){.dc-hall{display:none}.dc-inner{grid-template-columns:1fr;justify-items:center;min-height:44px}.dc-link{justify-self:center;font-size:12px}.dc-inner{padding-inline:16px}}
  @media(prefers-reduced-motion:reduce){.dc-scene :global(.led){animation:none}.dc-arrow{transition:none}}
</style>
