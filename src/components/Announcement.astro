---
/** Top announcement bar. */
interface Props { announcement?: string }
const { announcement = "Design partner places are open" } = Astro.props;
---
<div class="ann dc-bar">
  <div class="dc-inner">
    <a class="dc-link" href="#talk"><span class="dc-dot" aria-hidden="true"></span><span>{announcement}</span><span class="dc-arrow" aria-hidden="true">↗</span></a>
  </div>
</div>
<style>
  .ann.dc-bar{position:relative;z-index:3;display:block;margin:0;padding:0;background:#221A21;color:#F7F0ED;border-bottom:1px solid #3E2F39;font-family:var(--font)}
  .dc-inner{display:flex;align-items:center;justify-content:center;max-width:1200px;min-height:44px;margin-inline:auto;padding-inline:max(16px,4vw)}
  .dc-link{display:inline-flex;align-items:center;gap:10px;min-height:36px;color:#F7F0ED;text-decoration:none;font-size:13px;font-weight:500;letter-spacing:.01em;white-space:nowrap}
  .dc-dot{width:7px;height:7px;border-radius:50%;background:#B89CC8;box-shadow:0 0 0 3px #B89CC833}
  .dc-arrow{color:#B89CC8;font-size:15px;transition:transform .2s,color .2s}
  .dc-link:hover .dc-arrow{color:#F7F0ED;transform:translate(2px,-2px)}
  .dc-link:focus-visible{outline:2px solid #B89CC8;outline-offset:3px;border-radius:4px}
  @media(max-width:560px){.dc-link{font-size:12px}}
  @media(prefers-reduced-motion:reduce){.dc-arrow{transition:none}}
</style>
